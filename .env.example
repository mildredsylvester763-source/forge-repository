# Copy to .env for local development. NEVER commit real values.
FORGE_ENV=development
FORGE_HOST=127.0.0.1
FORGE_PORT=8080

# Required in production. Generate each with: openssl rand -base64 32
# Format: version:base64,version:base64  (highest version signs new hashes; older ones still verify)
FORGE_PASSWORD_PEPPERS=1:REPLACE_WITH_32_RANDOM_BYTES_BASE64
FORGE_AUDIT_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64

# Exact browser origins allowed to make state-changing requests (comma separated)
FORGE_ALLOWED_ORIGINS=https://app.example.com

# Number of reverse proxies in front of this service (0 = none). Controls X-Forwarded-For trust.
FORGE_TRUST_PROXY_HOPS=0

# fail-closed (default): refuse registration if the breach service is unreachable
FORGE_BREACH_MODE=fail-closed

# Where the SQLite database file lives (development, tests, single server). Keep it on a persistent disk.
# Production will use a PostgreSQL connection string instead once that adapter is built.
FORGE_DATABASE_PATH=/var/lib/forge/forge.db

# Automatic verified backups (strongly recommended). Keep this on a different disk if you can.
FORGE_BACKUP_DIR=/var/backups/forge
FORGE_BACKUP_INTERVAL_HOURS=6
FORGE_BACKUP_KEEP=28
