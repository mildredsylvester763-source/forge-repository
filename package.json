{
  "name": "forge-backend",
  "version": "0.1.0",
  "private": true,
  "description": "FORGE backend. First feature: CO-001 email and password sign-in with breached-password checks.",
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node src/main.ts",
    "backup": "node dist/cli.js backup",
    "backup:verify": "node dist/cli.js verify"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
